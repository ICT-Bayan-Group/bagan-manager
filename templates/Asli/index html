<!DOCTYPE html>
<html>
<head>
    <title>Pro Tournament Dashboard</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-bracket/0.11.1/jquery.bracket.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-bracket/0.11.1/jquery.bracket.min.css">
    
    <style>
        body { background: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 20px;}
        .section-title { text-align: center; color: #2c3e50; padding: 10px; border-bottom: 2px solid #3498db; margin-bottom: 20px; position: relative;}
        
        #toggle-bracket-btn { padding: 8px 15px; font-size: 14px; cursor: pointer; background: #3498db; color: white; border: none; border-radius: 5px; vertical-align: middle; transition: 0.3s; margin-left: 15px; font-weight: bold;}
        #toggle-bracket-btn:hover { filter: brightness(1.1); box-shadow: 0 4px 8px rgba(52, 152, 219, 0.4);}

        .bracket-selected { background-color: #e67e22 !important; color: white !important; font-weight: bold; border-radius: 3px; }

        .bracket-container { display: flex; justify-content: center; overflow-x: auto; padding-bottom: 40px; padding-top: 40px; transition: 0.3s ease; }
        
        .jBracket .connector, .jBracket .connector div, .jBracket .match, .jBracket .team { transition: border-color 0.2s ease, opacity 0.2s ease; }
        .bracket-dimmed .jBracket .match { opacity: 0.25; filter: grayscale(100%); }
        .bracket-dimmed .jBracket .match.highlight-match { opacity: 1; filter: none; position: relative; z-index: 10; }

        .highlight-match .connector, .highlight-match .connector div { border-color: #e67e22 !important; }
        #left-side .highlight-match .team { border-right: 3px solid #e67e22 !important; }
        #right-side .highlight-match .team { border-left: 3px solid #e67e22 !important; }
        .highlight-match .team .label { font-weight: bold !important; color: #d35400 !important; }

        .right-bracket { transform: scaleX(-1); }
        .right-bracket .team, .right-bracket .score { transform: scaleX(-1); text-align: right; }
        
        /* ----------------------------------------------------------- */
        /* KOMPRESI MAKSIMAL: UKURAN HURUF DAN KOTAK SUPER KECIL       */
        /* ----------------------------------------------------------- */
        .jBracket .team { color: #000 !important; background: #fff !important; } 
        .jBracket .team .label { font-size: 11px !important; font-weight: 500; padding-top: 1px !important; padding-bottom: 1px !important; }
        .jBracket .team .score { font-size: 11px !important; font-weight: bold !important; padding-top: 1px !important; padding-bottom: 1px !important; }

        .jBracket .round { position: relative !important; } 
        .bracket-round-header { position: absolute; top: -40px; width: 100%; text-align: center; z-index: 50; }
        .br-title { font-weight: 800; color: #d35400; font-size: 11px; letter-spacing: 0.5px; }
        .br-date { font-size: 10px; color: #34495e; font-weight: bold; background: #ecf0f1; padding: 2px 4px; border-radius: 3px; display: inline-block; margin-top: 2px; border: 1px solid #bdc3c7;}
        #right-side .bracket-round-header { transform: scaleX(-1); } 

        .final-center { width: 100px; text-align: center; margin: 0 10px; align-self: center; }
        .final-center h3 { font-size: 1.1em; margin: 0; }
        /* ----------------------------------------------------------- */
        
        .schedule-wrapper { display: flex; justify-content: space-around; gap: 20px; margin-top: 10px; }
        .schedule-box { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 48%; height: 600px; overflow-y: auto;}
        
        table { width: 100%; border-collapse: collapse; font-size: 15px; } 
        th, td { padding: 12px 10px; border-bottom: 1px solid #ddd; text-align: center; }
        th { background-color: #34495e; color: white; position: sticky; top: 0; z-index: 10; font-size: 15px; }
        
        .round-header td { background-color: #2c3e50; color: white; text-align: left; padding: 10px 15px; }
        
        .score-input { width: 45px; text-align: center; padding: 8px; border: 1px solid #bdc3c7; border-radius: 4px; font-size: 16px; font-weight: bold; transition: 0.3s;}
        .score-input:focus { border-color: #3498db; outline: none; box-shadow: 0 0 5px rgba(52, 152, 219, 0.5);}
        .date-input { width: 130px; padding: 6px; border: 1px solid #bdc3c7; border-radius: 4px; font-size: 14px; }
        .venue-input { width: 150px; padding: 8px; border: 1px solid #bdc3c7; border-radius: 4px; font-size: 14px; text-align: center;}
        
        .control-panel { background: #34495e; color: white; padding: 20px; border-radius: 8px; text-align: center; margin-bottom: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.15);}
        .control-panel label { font-size: 1.2em; font-weight: bold; }
        .control-panel input { padding: 10px 15px; border-radius: 4px; border: none; font-size: 15px; margin: 0 10px; outline: none;}
        .control-panel button { color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-weight: bold; transition: 0.2s; font-size: 15px; margin: 0 5px;}
        
        .btn-search { background: #e67e22; }
        .btn-search:hover { background: #d35400; transform: translateY(-2px); }
        .btn-reset { background: #95a5a6; }
        .btn-reset:hover { background: #7f8c8d; transform: translateY(-2px); }
        
        .info-box { background: #f39c12; color: white; padding: 15px; border-radius: 5px; text-align: center; margin-bottom: 20px; font-size: 15px; font-weight: bold;}
        .swappable { cursor: pointer; transition: 0.2s; border: 2px solid transparent; font-weight: 500;}
        .swappable:hover { background-color: #f1c40f; color: #333; border-radius: 5px; }
        .selected-swap { background-color: #e67e22 !important; color: white !important; font-weight: bold; border-radius: 5px; border: 2px dashed #fff; }

        .save-toast {
            position: fixed; bottom: 20px; right: 20px; background: #2ecc71; color: white; padding: 12px 25px;
            border-radius: 5px; font-weight: bold; font-size: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            display: none; z-index: 9999;
        }
    </style>
</head>
<body>

    <div id="save-toast" class="save-toast">Tersimpan otomatis ✅</div>

    <h2 class="section-title">
        📺 LIVE BRACKET VIEWER
        <button id="toggle-bracket-btn" onclick="toggleBracket()">👁️ Tampilkan Bagan</button>
    </h2>
    
    <div class="bracket-container" id="bracket-section" style="display: none;">
        <div id="left-side"></div>
        <div class="final-center">
            <h3 style="color: #d4af37; text-shadow: 1px 1px 2px rgba(0,0,0,0.1);">GRAND FINAL</h3>
        </div>
        <div id="right-side" class="right-bracket"></div>
    </div>

    <h2 class="section-title">📝 ADMIN PANEL: JADWAL & PENGATURAN</h2>

    <div class="info-box">
        💡 TIPS: Cukup ketik Skor atau Lokasi, sistem akan menyimpan otomatis! Klik nama tim di Babak 1 untuk menukar posisi.
    </div>
    
    <div class="control-panel">
        <label>Cari Tanggal Pertandingan:</label>
        <input type="date" id="global-date-filter" onchange="filterSchedule()">
        <button class="btn-search" onclick="filterSchedule()">🎯 Sorot Jadwal</button>
        <button class="btn-reset" onclick="resetFilter()">🔄 Reset Tampilan</button>
    </div>

    <div class="schedule-wrapper">
        <div class="schedule-box">
            <h3 style="text-align: center; color: #2980b9; font-size: 1.4em;">Jadwal Sayap Kiri</h3>
            <table>
                <tr><th>Match #</th><th>Tempat / Venue</th><th>Tim Kiri</th><th>Skor</th><th>Tim Kanan</th></tr>
                
                {% for round_num, matches in jadwal_kiri|groupby('round') %}
                <tr class="round-header">
                    <td colspan="5">
                        <span style="font-size: 1.1em; font-weight: bold; margin-right: 20px; color: #f1c40f;">BABAK {{ round_num }}</span>
                        📅 Atur Tanggal: <input type="date" id="kiri-round-date-{{ matches[0].r_idx }}" class="date-input" style="margin-left: 10px;" value="{{ matches[0].tanggal }}" onchange="updateRoundDate('kiri', {{ matches[0].r_idx }}, this.value)">
                    </td>
                </tr>
                {% for j in matches %}
                <tr class="match-row" data-tanggal="{{ j.tanggal }}" data-side="kiri" data-ridx="{{ j.r_idx }}" data-midx="{{ j.m_idx }}">
                    <td style="font-weight: bold; color: #555;">{{ j.match }}</td>
                    <td><input type="text" id="kiri-venue-{{ j.r_idx }}-{{ j.m_idx }}" class="venue-input" value="{{ j.venue }}" placeholder="Lokasi..." onchange="saveMatch('kiri', {{ j.r_idx }}, {{ j.m_idx }})"></td>
                    <td class="{% if j.round == 1 and j.team1 != 'Bye' and j.team1 != '-' %}swappable{% endif %}" data-team="{{ j.team1 }}" style="text-align: right;">{{ j.team1 }}</td>
                    <td style="white-space: nowrap;">
                        <input type="number" id="kiri-s1-{{ j.r_idx }}-{{ j.m_idx }}" class="score-input" value="{{ j.score1 }}" onchange="saveMatch('kiri', {{ j.r_idx }}, {{ j.m_idx }})"> - 
                        <input type="number" id="kiri-s2-{{ j.r_idx }}-{{ j.m_idx }}" class="score-input" value="{{ j.score2 }}" onchange="saveMatch('kiri', {{ j.r_idx }}, {{ j.m_idx }})">
                    </td>
                    <td class="{% if j.round == 1 and j.team2 != 'Bye' and j.team2 != '-' %}swappable{% endif %}" data-team="{{ j.team2 }}" style="text-align: left;">{{ j.team2 }}</td>
                </tr>
                {% endfor %}
                {% endfor %}
            </table>
        </div>

        <div class="schedule-box">
            <h3 style="text-align: center; color: #c0392b; font-size: 1.4em;">Jadwal Sayap Kanan</h3>
            <table>
                <tr><th>Match #</th><th>Tempat / Venue</th><th>Tim Kiri</th><th>Skor</th><th>Tim Kanan</th></tr>
                
                {% for round_num, matches in jadwal_kanan|groupby('round') %}
                <tr class="round-header">
                    <td colspan="5">
                        <span style="font-size: 1.1em; font-weight: bold; margin-right: 20px; color: #f1c40f;">BABAK {{ round_num }}</span>
                        📅 Atur Tanggal: <input type="date" id="kanan-round-date-{{ matches[0].r_idx }}" class="date-input" style="margin-left: 10px;" value="{{ matches[0].tanggal }}" onchange="updateRoundDate('kanan', {{ matches[0].r_idx }}, this.value)">
                    </td>
                </tr>
                {% for j in matches %}
                <tr class="match-row" data-tanggal="{{ j.tanggal }}" data-side="kanan" data-ridx="{{ j.r_idx }}" data-midx="{{ j.m_idx }}">
                    <td style="font-weight: bold; color: #555;">{{ j.match }}</td>
                    <td><input type="text" id="kanan-venue-{{ j.r_idx }}-{{ j.m_idx }}" class="venue-input" value="{{ j.venue }}" placeholder="Lokasi..." onchange="saveMatch('kanan', {{ j.r_idx }}, {{ j.m_idx }})"></td>
                    <td class="{% if j.round == 1 and j.team1 != 'Bye' and j.team1 != '-' %}swappable{% endif %}" data-team="{{ j.team1 }}" style="text-align: right;">{{ j.team1 }}</td>
                    <td style="white-space: nowrap;">
                        <input type="number" id="kanan-s1-{{ j.r_idx }}-{{ j.m_idx }}" class="score-input" value="{{ j.score1 }}" onchange="saveMatch('kanan', {{ j.r_idx }}, {{ j.m_idx }})"> - 
                        <input type="number" id="kanan-s2-{{ j.r_idx }}-{{ j.m_idx }}" class="score-input" value="{{ j.score2 }}" onchange="saveMatch('kanan', {{ j.r_idx }}, {{ j.m_idx }})">
                    </td>
                    <td class="{% if j.round == 1 and j.team2 != 'Bye' and j.team2 != '-' %}swappable{% endif %}" data-team="{{ j.team2 }}" style="text-align: left;">{{ j.team2 }}</td>
                </tr>
                {% endfor %}
                {% endfor %}
            </table>
        </div>
    </div>

    <script>
        $(function() {
            var timKiri = {{ tim_kiri | tojson }};
            var timKanan = {{ tim_kanan | tojson }};
            var resKiri = {{ skor_kiri | tojson }};
            var resKanan = {{ skor_kanan | tojson }};

            // -----------------------------------------------------------------
            // KONFIGURASI BAGAN: KOMPRESI MAKSIMAL
            // -----------------------------------------------------------------
            $('#left-side').bracket({ 
                init: { teams: timKiri, results: resKiri }, 
                skipConsolationRound: true,
                teamWidth: 90,        // KOTAK TIM DIPERKECIL EKSTREM
                scoreWidth: 20,       // KOTAK SKOR DIPERKECIL EKSTREM
                matchMargin: 8,       // JARAK VERTIKAL SUPER RAPAT
                roundMargin: 25       // JARAK HORIZONTAL SUPER RAPAT
            });
            $('#right-side').bracket({ 
                init: { teams: timKanan, results: resKanan }, 
                skipConsolationRound: true,
                teamWidth: 90, 
                scoreWidth: 20, 
                matchMargin: 8, 
                roundMargin: 25
            });

            syncBracketHeaders();

            let selectedTeam = null;

            function handleSwap(teamName, elementClicked) {
                if (!teamName || teamName === "Bye" || teamName === "-") return;

                if (!selectedTeam) {
                    selectedTeam = teamName;
                    if ($(elementClicked).hasClass('swappable')) $(elementClicked).addClass('selected-swap'); 
                    else $(elementClicked).parent().addClass('bracket-selected'); 
                } 
                else if (selectedTeam === teamName) {
                    selectedTeam = null;
                    $('.swappable').removeClass('selected-swap');
                    $('.jBracket .team').removeClass('bracket-selected');
                } 
                else {
                    let confirmSwap = confirm(`Tukar posisi "${selectedTeam}" dengan "${teamName}"?`);
                    if (confirmSwap) {
                        fetch('/swap_teams', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ team1: selectedTeam, team2: teamName })
                        }).then(res => res.json()).then(data => {
                            if(data.status === "success") location.reload(); 
                            else alert(data.message);
                        });
                    }
                    selectedTeam = null;
                    $('.swappable').removeClass('selected-swap');
                    $('.jBracket .team').removeClass('bracket-selected');
                }
            }

            $('.swappable').click(function() { handleSwap($(this).data('team'), this); });
            $(document).on('click', '.jBracket .round:first-child .team .label', function() { handleSwap($(this).text().trim(), this); });
        }); 

        function syncBracketHeaders() {
            $('.bracket-round-header').remove(); 
            
            $('#left-side .round').each(function(i) {
                var tgl = $('#kiri-round-date-' + i).val();
                var tglText = tgl ? tgl : "TBA";
                $(this).prepend(`
                    <div class="bracket-round-header">
                        <div class="br-title">BABAK ${i+1}</div>
                        <div class="br-date">${tglText}</div>
                    </div>
                `);
            });

            $('#right-side .round').each(function(i) {
                var tgl = $('#kanan-round-date-' + i).val();
                var tglText = tgl ? tgl : "TBA";
                $(this).prepend(`
                    <div class="bracket-round-header">
                        <div class="br-title">BABAK ${i+1}</div>
                        <div class="br-date">${tglText}</div>
                    </div>
                `);
            });
        }

        function toggleBracket() {
            var bracketSection = document.getElementById("bracket-section");
            var btn = document.getElementById("toggle-bracket-btn");
            if (bracketSection.style.display === "none") {
                bracketSection.style.display = "flex";
                btn.innerHTML = "🙈 Sembunyikan Bagan";
                btn.style.background = "#e74c3c";
            } else {
                bracketSection.style.display = "none";
                btn.innerHTML = "👁️ Tampilkan Bagan";
                btn.style.background = "#3498db";
            }
        }

        function showToast(msg) {
            $('#save-toast').text(msg).fadeIn(200).delay(1500).fadeOut(300);
        }

        let autoReloadTimer;
        $(document).on('focus', 'input', function() { clearTimeout(autoReloadTimer); });

        function saveMatch(side, r_idx, m_idx) {
            var score1 = $(`#${side}-s1-${r_idx}-${m_idx}`).val();
            var score2 = $(`#${side}-s2-${r_idx}-${m_idx}`).val();
            var venue = $(`#${side}-venue-${r_idx}-${m_idx}`).val();
            var tanggal = $(`#${side}-round-date-${r_idx}`).val(); 

            $(`#${side}-s1-${r_idx}-${m_idx}, #${side}-s2-${r_idx}-${m_idx}`).css('background-color', '#eafaf1');
            setTimeout(() => {
                $(`#${side}-s1-${r_idx}-${m_idx}, #${side}-s2-${r_idx}-${m_idx}`).css('background-color', '#fff');
            }, 800);

            fetch('/update_match', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    side: side, r_idx: r_idx, m_idx: m_idx, score1: score1, score2: score2, tanggal: tanggal, venue: venue
                })
            }).then(res => res.json()).then(data => {
                if(data.status === "success") {
                    showToast("Tersimpan otomatis ✅");
                    clearTimeout(autoReloadTimer);
                    autoReloadTimer = setTimeout(() => {
                        if (!$("input").is(":focus")) location.reload(); 
                    }, 1500);
                } 
                else alert("Gagal menyimpan skor!");
            });
        }

        function updateRoundDate(side, r_idx, tanggal) {
            fetch('/update_round_date', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ side: side, r_idx: r_idx, tanggal: tanggal })
            }).then(res => res.json()).then(data => {
                if(data.status === "success") {
                    showToast("Tanggal babak diperbarui! 🗓️");
                    setTimeout(() => location.reload(), 800);
                }
            });
        }

        function filterSchedule() {
            var selectedDate = $('#global-date-filter').val();
            if (!selectedDate) { resetFilter(); return; }
            
            $('.match-row').removeClass('active-row');
            $('.round-header').hide(); 

            $('.match-row').each(function() {
                var rowDate = $(this).data('tanggal');
                if (rowDate === selectedDate) {
                    $(this).show();
                    $(this).addClass('active-row');
                    $(this).prevAll('.round-header:first').show(); 
                } else {
                    $(this).hide();
                }
            });
            syncBracketHighlight();
        }

        function syncBracketHighlight() {
            $('.highlight-match').removeClass('highlight-match');
            $('#bracket-section').removeClass('bracket-dimmed');
            var voidReflow = document.getElementById("bracket-section").offsetHeight;

            if ($('.match-row.active-row').length > 0) {
                $('#bracket-section').addClass('bracket-dimmed');
                $('.match-row.active-row').each(function() {
                    var side = $(this).data('side');
                    var r_idx = parseInt($(this).data('ridx'));
                    var m_idx = parseInt($(this).data('midx'));

                    var targetSideId = side === 'kiri' ? '#left-side' : '#right-side';
                    var matchEl = $(targetSideId).find('.round').eq(r_idx).find('.match').eq(m_idx);
                    matchEl.addClass('highlight-match'); 
                });

                var bracketSection = document.getElementById("bracket-section");
                if (bracketSection.style.display === "none") toggleBracket(); 
            } else {
                alert("Tidak ada jadwal pertandingan pada tanggal tersebut.");
                resetFilter();
            }
        }

        function resetFilter() {
            $('#global-date-filter').val('');
            $('.match-row').show().removeClass('active-row');
            $('.round-header').show();
            $('.highlight-match').removeClass('highlight-match');
            $('#bracket-section').removeClass('bracket-dimmed');
        }
    </script>
</body>
</html>